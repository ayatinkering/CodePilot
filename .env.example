# Copy to .env; never commit real credentials.
CODEPILOT_DATA_DIR=.codepilot
CODEPILOT_PROVIDER=offline
# Optional for Live Gemini. Never send keys in chat.
GEMINI_API_KEY=
# Exact model must be selected from models available to your key.
CODEPILOT_MODEL=gemini-3.5-flash

# Set to docker image inspect output after building the runner.
CODEPILOT_RUNNER_IMAGE=
CODEPILOT_GITHUB_REPO=ayatinkering/CodePilot
